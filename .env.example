
# OrangeHRM demo or authorized test environment
BASE_URL=https://opensource-demo.orangehrmlive.com
API_BASE_URL=https://opensource-demo.orangehrmlive.com

# Required admin credentials: configure these in your local .env file
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional ESS credentials for role-access testing
ESS_USERNAME=
ESS_PASSWORD=

# Optional k6 configuration; use only an authorized test environment
K6_BASE_URL=http://localhost:3000
K6_LOGIN_PATH=/api/auth/login
K6_EMPLOYEE_PATH=/api/employees
K6_USERNAME=load-test-user
K6_PASSWORD=change-me
