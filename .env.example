# OrangeHRM public demo URL (use a permitted test environment for repeated runs)
BASE_URL=https://opensource-demo.orangehrmlive.com
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=admin123
# Optional: provide a real low-privilege test account to execute role restrictions.
ESS_USERNAME=
ESS_PASSWORD=
# Optional API base URL; defaults to BASE_URL
API_BASE_URL=https://opensource-demo.orangehrmlive.com
# k6 endpoints are intentionally configurable; do not load-test the public demo without permission.
K6_BASE_URL=http://localhost:3000
K6_LOGIN_PATH=/api/auth/login
K6_EMPLOYEE_PATH=/api/employees
K6_USERNAME=load-test-user
K6_PASSWORD=change-me
